# Text and JSON rendering


def format_table(headers: list[str], rows: list[list[object]]) -> str:
    widths = [len(h) for h in headers]
    for row in rows:
        for idx, cell in enumerate(row):
            widths[idx] = max(widths[idx], len(str(cell)))
    fmt = "  ".join(f"{{:<{width}}}" for width in widths)
    lines = [fmt.format(*headers), fmt.format(*["-" * width for width in widths])]
    lines.extend(fmt.format(*[str(cell) for cell in row]) for row in rows)
    return "\n".join(lines)


def print_json(data: object) -> None:
    print(json.dumps(data, indent=2, sort_keys=True))


def emit(
    data: T,
    *,
    as_json: bool,
    render_text: Callable[[T], str],
) -> None:
    if as_json:
        print_json(data)
    else:
        print(render_text(data))


def render_status_text(data: PjlFields) -> str:
    rows = []
    derived_fields = {"raw", "code_name", "code_label"}
    for key, value in data.items():
        if key not in derived_fields:
            rows.append([key, status_code_label(value) if key == "code" else value])
    return format_table(["Field", "Value"], rows)


def render_supplies_text(data: SuppliesResult) -> str:
    rows = [
        [
            cartridge.get("color", ""),
            cartridge.get("percent_remaining", "?"),
            cartridge.get("pages_remaining", "?"),
            cartridge.get("type", "?"),
            cartridge.get("reorder_pn", "?"),
            cartridge.get("page_count", "?"),
        ]
        for cartridge in data["cartridges"]
    ]
    return format_table(
        ["Cartridge", "Remain", "Pages", "Type", "Reorder", "Used"],
        rows,
    )


def render_config_text(data: ConfigReport) -> str:
    blocks = []
    capabilities = data["capabilities"]
    rows: list[list[object]] = [
        [key, value] for key, value in capabilities["values"].items()
    ]
    for key in ["languages", "resolution", "bitsperpixel", "in_trays"]:
        values = capabilities["sections"].get(key)
        if values is not None:
            rows.append([key, ", ".join(values)])
    if rows:
        blocks.append(
            "Capabilities\n" + format_table(["Field", "Value"], rows)
        )

    for title, section in [
        ("Paper Handling", data["paper"]),
        ("Print Settings", data["print"]),
        ("Product Settings", data["product_settings"]),
    ]:
        rows = [
            [field, value]
            for field, value in section.items()
            if field != "raw"
        ]
        if rows:
            blocks.append(f"{title}\n" + format_table(["Field", "Value"], rows))

    for title, section in [
        ("Density LUT", data["density_lut"]),
        ("Color Metrics", data["color_metrics"]),
        ("Bow/Tilt", data["bow_tilt"]),
    ]:
        rows = [
            [field, ", ".join(str(value) for value in values)]
            for field, values in section["values"].items()
        ]
        if rows:
            blocks.append(f"{title}\n" + format_table(["Field", "Value"], rows))
    return "\n\n".join(blocks)


def render_events_text(data: EventLogResult) -> str:
    rows = [
        [
            event.get("event", ""),
            event.get("page_count", ""),
            event.get("err_code", ""),
            event.get("err_name", "Unknown"),
        ]
        for event in data["events"]
    ]
    if not rows:
        return "No printer event-log entries reported."
    return format_table(["Event", "Page", "Code", "Meaning"], rows)


def render_info_text(data: InfoReport) -> str:
    blocks = []
    product = data["product"]
    rows: list[list[object]] = []
    for key in [
        "product_name",
        "device_description",
        "product_serial_number",
        "firmware_date_code",
        "service_id",
        "formatter_number",
        "printer_number",
        "device_lang",
        "max_print_resolution",
    ]:
        if key in product:
            rows.append([key, product[key]])

    rows.append(["page_count", data["pagecount"]["page_count"]])
    memory_value = data["memory"].get("total_bytes", data["memory"].get("total", ""))
    rows.append(["memory_bytes", memory_value])

    user_memory = data["user_memory"]
    if "total_memory" in user_memory:
        rows.append(["user_total_memory_mb", user_memory["total_memory"]])
    if "available_memory" in user_memory:
        rows.append(["user_available_memory_mb", user_memory["available_memory"]])

    service_id = data["service_id"]["value"]
    if service_id not in (None, ""):
        rows.append(["service_id_inquire", service_id])
    region_id = data["region_id"]["value"]
    if region_id not in (None, ""):
        rows.append(["region_id", region_id])
    blocks.append("Product\n" + format_table(["Field", "Value"], rows))

    usage_rows = [
        [key, value]
        for key, value in data["tracking"].items()
        if key != "raw"
    ]
    if usage_rows:
        blocks.append("Usage\n" + format_table(["Field", "Value"], usage_rows))
    return "\n\n".join(blocks)


