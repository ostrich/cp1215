def snake(name: str) -> str:
    name = name.strip().replace("-", "_")
    name = re.sub(r"([a-z0-9])([A-Z])", r"\1_\2", name)
    name = re.sub(r"[^A-Za-z0-9]+", "_", name)
    return name.strip("_").lower()


def decode_response(data: bytes) -> str:
    text = data.replace(UEL, b"").decode("latin1", "replace")
    return text.replace("\r\n", "\n").replace("\r", "\n").strip("\x0c\n ")


# Device transport


def _write_all(fd: int, payload: bytes, timeout: float) -> None:
    deadline = time.monotonic() + timeout
    offset = 0

    while offset < len(payload):
        try:
            written = os.write(fd, payload[offset:])
        except BlockingIOError:
            written = 0

        if written > 0:
            offset += written
            continue

        wait = deadline - time.monotonic()
        if wait <= 0:
            raise WriteTimeoutError(
                f"Timed out writing printer command ({offset} of {len(payload)} bytes sent)"
            )
        _, writable, _ = select.select([], [fd], [], min(0.25, wait))
        if not writable:
            continue


def _transact(
    payload: bytes,
    device: str,
    timeout: float = DEFAULT_COMMAND_TIMEOUT,
    limit: int = DEFAULT_COMMAND_LIMIT,
    require_response: bool = False,
) -> str:
    flags = os.O_RDWR | os.O_NONBLOCK
    try:
        fd = os.open(device, flags)
    except PermissionError as exc:
        raise DeviceAccessError(
            f"Permission denied opening {device}. Add this user to the lp group, "
            f"adjust udev permissions, or run this command with suitable privileges."
        ) from exc
    except FileNotFoundError as exc:
        raise DeviceAccessError(f"Printer device not found: {device}") from exc
    except OSError as exc:
        raise DeviceAccessError(f"Could not open {device}: {exc.strerror or exc}") from exc

    try:
        if not stat.S_ISCHR(os.fstat(fd).st_mode):
            raise DeviceAccessError(
                f"Refusing to use non-character device as printer: {device}"
            )

        _write_all(fd, payload, timeout)
        chunks: list[bytes] = []
        received = 0
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline and received < limit:
            wait = max(0.0, deadline - time.monotonic())
            readable, _, _ = select.select([fd], [], [], min(0.25, wait))
            if not readable:
                continue
            try:
                chunk = os.read(fd, min(4096, limit - received))
            except BlockingIOError:
                continue
            if not chunk:
                break
            chunks.append(chunk)
            received += len(chunk)
            if b"\x0c" in chunk:
                break
        if require_response and not chunks:
            raise NoResponseError(f"No response from {device}")
        return decode_response(b"".join(chunks))
    except OSError as exc:
        raise DeviceAccessError(
            f"I/O error communicating with {device}: {exc.strerror or exc}"
        ) from exc
    finally:
        try:
            os.close(fd)
        except OSError:
            # Closing cannot make an already completed command more reliable,
            # and must not mask a more useful communication error.
            pass


def build_http_get(path: str) -> bytes:
    return UEL + b"@PJL ENTER LANGUAGE=HTTP\r\nGET " + path.encode("ascii") + b" \r\n\r\n"


def build_http_post(path: str, body: bytes) -> bytes:
    return (
        UEL
        + b"@PJL ENTER LANGUAGE=HTTP\r\n"
        + b"POST "
        + path.encode("ascii")
        + b" HTTP/1.1 \r\n"
        + b"CONTENT-LENGTH:"
        + str(len(body)).encode("ascii")
        + b" \r\n\r\n"
        + body
    )


@dataclass(frozen=True, slots=True)
class Cp1215Client:
    """Stateless printer client; each transaction opens the configured device."""

    device: str

    def query_pjl(
        self,
        command: str,
        timeout: float = DEFAULT_QUERY_TIMEOUT,
        limit: int = DEFAULT_QUERY_LIMIT,
    ) -> str:
        payload = UEL + command.encode("ascii") + b"\r\n" + UEL
        return _transact(
            payload,
            self.device,
            timeout,
            limit,
            require_response=True,
        )

    def query_parsed(
        self,
        command: str,
        parser: Callable[[str], T],
        timeout: float = DEFAULT_QUERY_TIMEOUT,
        limit: int = DEFAULT_QUERY_LIMIT,
    ) -> T:
        return parser(self.query_pjl(command, timeout=timeout, limit=limit))

    def send_pjl_command(
        self,
        command: str,
        timeout: float = DEFAULT_COMMAND_TIMEOUT,
    ) -> str:
        payload = UEL + command.encode("ascii") + b"\r\n" + UEL
        return _transact(
            payload,
            self.device,
            timeout=timeout,
            limit=DEFAULT_COMMAND_LIMIT,
            require_response=False,
        )

    def query_http(
        self,
        path: str,
        timeout: float = DEFAULT_QUERY_TIMEOUT,
        limit: int = DEFAULT_QUERY_LIMIT,
    ) -> str:
        return _transact(
            build_http_get(path),
            self.device,
            timeout=timeout,
            limit=limit,
            require_response=True,
        )

    def post_setting(
        self,
        name: str,
        value: PjlScalar,
        timeout: float = DEFAULT_COMMAND_TIMEOUT,
    ) -> str:
        body = f"\tSID+{name}={value}& \r\n".encode("ascii")
        return _transact(
            build_http_post(SSI_CONFIG_PATH, body),
            self.device,
            timeout=timeout,
            limit=DEFAULT_COMMAND_LIMIT,
        )

    def status_codes(self, timeout: float = DEFAULT_QUERY_TIMEOUT) -> list[int]:
        response = self.query_http(DEVICE_STATUS_PATH, timeout=timeout)
        return parse_device_status_codes(response)


# Response parsing


def parse_key_values(text: str) -> PjlFields:
    result: PjlFields = {"raw": text}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("@PJL"):
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        value = value.strip().strip('"')
        result[snake(key)] = coerce_value(value)
    return result


def coerce_value(value: str) -> PjlScalar:
    if value in {"TRUE", "FALSE"}:
        return value == "TRUE"
    if re.fullmatch(r"-?\d+", value):
        try:
            return int(value)
        except ValueError:
            return value
    return value


def status_code_name(code: PjlScalar | None) -> str | None:
    return STATUS_CODE_NAMES.get(code) if type(code) is int else None


def status_code_label(code: PjlScalar | None) -> str:
    name = status_code_name(code)
    if name:
        return f"{name} ({code})"
    return str(code)


def event_log_code_name(code: PjlScalar | None) -> str | None:
    code_text = str(code).strip()
    if not code_text:
        return None
    for prefix, name in EVENT_LOG_PREFIXES:
        normalized_code = code_text.upper()
        normalized_prefix = prefix.upper()
        if "." in normalized_prefix:
            matched = normalized_code == normalized_prefix or normalized_code.startswith(
                normalized_prefix
            )
        else:
            matched = normalized_code == normalized_prefix or normalized_code.startswith(
                normalized_prefix + "."
            )
        if matched:
            return name
    return None


def event_log_code_label(code: PjlScalar | None) -> str:
    name = event_log_code_name(code)
    if name:
        return f"{name} ({code})"
    return str(code)


def parse_supplies(text: str) -> SuppliesResult:
    cartridges: list[Cartridge] = []
    current: Cartridge | None = None

    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("@PJL"):
            continue
        if line.upper().startswith("CARTRIDGE") and "=" in line:
            if current:
                cartridges.append(current)
            _, value = line.split("=", 1)
            current = {"color": value.strip()}
            continue
        if current is not None and "=" in line:
            key, value = line.split("=", 1)
            current[snake(key)] = coerce_value(value.strip())

    if current:
        cartridges.append(current)
    return {"cartridges": cartridges, "raw": text}


def parse_config(text: str) -> ConfigResult:
    sections: dict[str, list[str]] = {}
    values: PjlFields = {}
    current: str | None = None

    for raw_line in text.splitlines():
        if not raw_line.strip() or raw_line.startswith("@PJL"):
            continue
        if raw_line.startswith("\t") and current:
            sections[current].append(raw_line.strip())
            continue
        line = raw_line.strip()
        match = re.match(r"^(.+?)\s+\[\d+\s+ENUMERATED\]$", line)
        if match:
            current = snake(match.group(1))
            sections[current] = []
            continue
        current = None
        if "=" in line:
            key, value = line.split("=", 1)
            values[snake(key)] = coerce_value(value.strip())
    return {"raw": text, "sections": sections, "values": values}


def parse_event_log(text: str) -> EventLogResult:
    events_by_index: dict[int, Event] = {}
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("@PJL"):
            continue
        if line.upper().startswith("MARSLOGEND"):
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        match = re.fullmatch(r"([A-Za-z_]+)(\d+)", key.strip())
        if not match:
            continue
        field, index_text = match.groups()
        index = int(index_text)
        event = events_by_index.setdefault(index, {"event": index})
        event[snake(field)] = coerce_value(value.strip())

    events = [events_by_index[index] for index in sorted(events_by_index)]
    for event in events:
        if "err_code" in event:
            event["err_name"] = event_log_code_name(event["err_code"]) or "Unknown"
            event["err_label"] = event_log_code_label(event["err_code"])
    return {"events": events, "raw": text}


def parse_pagecount(text: str) -> PageCountResult:
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("@PJL"):
            continue
        if re.fullmatch(r"\d+", line):
            return {"page_count": int(line), "raw": text}
        if "=" in line:
            key, value = line.split("=", 1)
            if snake(key) == "pagecount":
                return {"page_count": coerce_value(value.strip()), "raw": text}
    return {"page_count": None, "raw": text}


def parse_memory(text: str) -> PjlFields:
    data = parse_key_values(text)
    if "total" in data and "total_bytes" not in data:
        data["total_bytes"] = data["total"]
    return data


def parse_scalar_response(text: str) -> ScalarResult:
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("@PJL"):
            continue
        return {"value": coerce_value(line.strip('"')), "raw": text}
    return {"value": None, "raw": text}


def parse_csv_values(text: str) -> CsvResult:
    values: dict[str, list[PjlScalar]] = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("@PJL") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        items = [coerce_value(item.strip()) for item in value.split(",")]
        values[snake(key)] = items
    return {"raw": text, "values": values}


def parse_device_status_codes(text: str) -> list[int]:
    return [int(code) for code in re.findall(r"<Code>\s*(\d+)\s*</Code>", text)]


# Printer operations and report assembly


def wait_for_action_complete(
    client: Cp1215Client,
    busy_codes: Collection[int],
    timeout: float,
    settle_after_status: float = 0.0,
) -> list[int]:
    started = time.monotonic()
    deadline = started + timeout
    last_codes: list[int] = []
    saw_busy = False
    status_clear_time: float | None = None

    while time.monotonic() < deadline:
        try:
            codes = client.status_codes(timeout=4.0)
        except TransientCommunicationError:
            time.sleep(STATUS_POLL_INTERVAL)
            continue
        if codes:
            last_codes = codes
            active_codes = [code for code in codes if code]
            if any(code in busy_codes for code in active_codes):
                saw_busy = True
                status_clear_time = None
            elif saw_busy:
                if settle_after_status <= 0:
                    return codes
                if status_clear_time is None:
                    status_clear_time = time.monotonic()
                elif time.monotonic() - status_clear_time >= settle_after_status:
                    return codes
            elif active_codes and time.monotonic() - started >= 6.0:
                return codes
        time.sleep(STATUS_POLL_INTERVAL)

    if last_codes:
        last_status = ", ".join(status_code_label(code) for code in last_codes)
    else:
        last_status = "no status response"
    raise Cp1215Error(
        f"Timed out waiting for printer action to complete; last status: {last_status}"
    )


def wait_for_cleaning_complete(
    client: Cp1215Client,
    timeout: float = 180.0,
) -> list[int]:
    return wait_for_action_complete(client, CLEANING_BUSY_CODES, timeout=timeout)


def wait_for_calibration_complete(
    client: Cp1215Client,
    timeout: float = 360.0,
) -> list[int]:
    return wait_for_action_complete(
