def run_doctor(client: Cp1215Client) -> DoctorResult:
    checks: list[DoctorCheck] = []
    checks.append(
        {
            "check": "Device path",
            "ok": os.path.exists(client.device),
            "detail": client.device,
        }
    )
    checks.append(
        {
            "check": "Device read/write permission",
            "ok": os.access(client.device, os.R_OK | os.W_OK),
            "detail": client.device,
        }
    )
    try:
        status = client.query_parsed(
            "@PJL INFO STATUS",
            parse_key_values,
            timeout=3.0,
            limit=4096,
        )
        code = status.get("code")
        online = status.get("online")
        valid_status = type(code) is int and type(online) is bool
        checks.append(
            {
                "check": "PJL status query",
                "ok": valid_status,
                "detail": (
                    f"code={status_code_label(code)} online={online}"
                    if valid_status
                    else (
                        "Malformed PJL status response: expected integer CODE "
                        "and boolean ONLINE"
                    )
                ),
            }
        )
    except Cp1215Error as exc:
        checks.append({"check": "PJL status query", "ok": False, "detail": str(exc)})
    return {"device": client.device, "checks": checks}


def render_doctor_text(result: DoctorResult) -> str:
    rows = [
        ["OK" if check["ok"] else "FAIL", check["check"], check["detail"]]
        for check in result["checks"]
    ]
    return format_table(["Result", "Check", "Detail"], rows)


def command_doctor(args: argparse.Namespace, client: Cp1215Client) -> int:
    result = run_doctor(client)
    emit(result, as_json=args.json, render_text=render_doctor_text)
    return 0 if all(check["ok"] for check in result["checks"]) else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="HP Color LaserJet CP1215 Linux maintenance utility"
    )
    parser.add_argument(
        "--device",
        default=DEFAULT_DEVICE,
        help=f"USB printer device, default {DEFAULT_DEVICE}",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    for name, func in [
        ("status", command_status),
        ("supplies", command_supplies),
        ("config", command_config),
        ("events", command_events),
        ("info", command_info),
        ("doctor", command_doctor),
    ]:
        p = sub.add_parser(name)
        p.add_argument("--json", action="store_true", help="emit JSON")
        p.set_defaults(func=func)

    service = sub.add_parser("service", help="run printer service actions")
    service_sub = service.add_subparsers(dest="service_command", required=True)

    clean = service_sub.add_parser("clean")
    clean.set_defaults(func=command_clean)

    calibrate = service_sub.add_parser("calibrate")
    calibrate.set_defaults(func=command_calibrate)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    client = Cp1215Client(args.device)
    try:
        return args.func(args, client)
    except Cp1215Error as exc:
        print(f"cp1215: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("cp1215: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
