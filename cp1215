def run_service_action(
    client: Cp1215Client,
    *,
    description: str,
    setting: str,
    wait_for_completion: Callable[[Cp1215Client], list[int]],
    final_note: str | None = None,
) -> int:
    print(f"Starting {description}...")
    client.post_setting(setting, 1, timeout=5.0)
    client.post_setting("FunctionGo", 1, timeout=5.0)
    codes = wait_for_completion(client)
    labels = [status_code_label(code) for code in codes if code]
    print("Final status: " + ", ".join(labels))
    if final_note:
        print(final_note)
    return 0


